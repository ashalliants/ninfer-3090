# Embeds a file in a target as a byte array, regenerated whenever the file changes.
#
#   ninfer_embed_file(<target> <input> <symbol>)
#
# adds a generated source to <target> that defines, in namespace ninfer::embedded,
#
#   extern const unsigned char <symbol>[];      // the file's bytes, not NUL-terminated
#   extern const std::size_t   <symbol>_size;
#
# The bytes are written as a hex array, 16 to a line, rather than as a string literal: MSVC
# refuses a string literal over 16 KB (C2026), and an array has no such limit. The same file runs
# as a script (cmake -P) to do the generation at build time.

if(CMAKE_SCRIPT_MODE_FILE)
  # Script mode: -DINPUT=<file> -DOUTPUT=<generated .cpp> -DSYMBOL=<name>.
  file(READ "${INPUT}" hex HEX)
  string(LENGTH "${hex}" hex_length)
  math(EXPR size "${hex_length} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REPEAT "0x[0-9a-f][0-9a-f]," 16 line_pattern)
  string(REGEX REPLACE "(${line_pattern})" "\\1\n" bytes "${bytes}")
  get_filename_component(input_name "${INPUT}" NAME)
  if(size EQUAL 0)
    # A zero-length array is not C++; keep one byte and report the size as 0.
    set(bytes "0x00,")
  endif()
  set(content "// Generated by cmake/EmbedFile.cmake from ${input_name}. Do not edit.
#include <cstddef>

namespace ninfer::embedded {

extern const unsigned char ${SYMBOL}[];
extern const std::size_t ${SYMBOL}_size;

const unsigned char ${SYMBOL}[] = {
${bytes}
};
const std::size_t ${SYMBOL}_size = ${size};

} // namespace ninfer::embedded
")
  # Leave an unchanged file alone, so a rerun does not force a recompile.
  file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${content}" @ONLY)
  return()
endif()

set(NINFER_EMBED_FILE_SCRIPT "${CMAKE_CURRENT_LIST_FILE}")

function(ninfer_embed_file target input symbol)
  get_filename_component(input "${input}" ABSOLUTE)
  set(output "${CMAKE_CURRENT_BINARY_DIR}/embedded/${symbol}.cpp")
  add_custom_command(
    OUTPUT "${output}"
    COMMAND "${CMAKE_COMMAND}" "-DINPUT=${input}" "-DOUTPUT=${output}" "-DSYMBOL=${symbol}"
            -P "${NINFER_EMBED_FILE_SCRIPT}"
    DEPENDS "${input}" "${NINFER_EMBED_FILE_SCRIPT}"
    COMMENT "Embedding ${symbol} from ${input}"
    VERBATIM)
  target_sources(${target} PRIVATE "${output}")
endfunction()
