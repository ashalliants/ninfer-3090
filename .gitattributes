# Preserve repository-pinned upstream sources byte-for-byte; NInfer-owned files retain Git's
# default whitespace checks.
/third_party/spdlog/include/** -whitespace
/third_party/spdlog/src/** -whitespace
/third_party/xgrammar/** -whitespace

# Shell scripts must be LF in the repository and in every checkout, not merely normalised on
# commit. `core.autocrlf=input` was not enough: every .sh in scripts/ had CRLF committed, and
# the two Linux launchers the README recommends (then run-qwen36-35b-a3b-c1-maxctx.sh and
# run-qwen38-c1-maxctx.sh, now replaced by scripts/run.sh) would not parse on Linux at all:
#
#     syntax error near unexpected token `$'in\r''
#
# A `case` block is where a stray CR becomes fatal rather than merely ugly, which is why only those
# two failed and the rest looked fine. Git Bash strips CR on read, so a Windows box reports every
# script healthy; the breakage only appears for the people the Linux archive ships to.
*.sh text eol=lf
*.bash text eol=lf
# The Windows counterparts want CRLF for the same reason, and pinning both directions keeps the
# pairs from drifting apart on whichever platform last touched them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# The launcher profiles are read by run.sh and run.bat alike: LF on every checkout, so run.sh's line
# reader never sees a stray CR (run.bat's for /f reads either).
/scripts/profiles/*.json text eol=lf
# The community rows file is checked byte for byte (LF line ends) by its ctest; a CRLF checkout
# from core.autocrlf would fail that check on every Windows clone.
/bench/community/rows.json text eol=lf
artifacts/grafts/*.bin filter=lfs diff=lfs merge=lfs -text
# Golden GGML decoder fixtures are raw little-endian bytes; never convert line endings.
/tests/fixtures/ggml/** binary
# The Flash-Next model card's LICENSE is Qwen's text byte for byte (CRLF), the same bytes as the copy
# in the Hugging Face repository.
/model-cards/Qwen3.8-Flash-Next-NInfer-3090/LICENSE -text
